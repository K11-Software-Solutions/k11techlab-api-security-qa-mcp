{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.K11-Software-Solutions/api-security-qa",
  "title": "k11 API Security QA",
  "description": "OWASP API Top 10 tests from your OpenAPI spec, plus scanner SARIF judged for release.",
  "websiteUrl": "https://github.com/K11-Software-Solutions/k11techlab-api-security-qa-mcp",
  "repository": {
    "url": "https://github.com/K11-Software-Solutions/k11techlab-api-security-qa-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "k11-api-security-qa-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "QA_MCP_ROOT",
