{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep OSS",
          "rules": [
            {
              "id": "python.lang.security.injection.sql-injection",
              "properties": {
                "security-severity": "8.6"
              }
            },
            {
              "id": "python.lang.security.audit.md5-used",
              "properties": {
                "security-severity": "5.0"
              }
            },
            {
              "id": "python.flask.security.audit.debug-enabled",
              "properties": {
                "security-severity": "7.5"
              }
            },
            {
              "id": "generic.secrets.gitleaks.generic-api-key",
              "properties": {
                "security-severity": "9.1"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.lang.security.injection.sql-injection",
          "level": "error",
          "message": {
            "text": "User input flows into a SQL query"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/accounts.py"
                },
                "region": {
                  "startLine": 42
                }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "sqli-acc-42"
          }
        },
        {
          "ruleId": "python.lang.security.audit.md5-used",
          "level": "warning",
          "message": {
            "text": "MD5 is a weak hash"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/legacy/checksum.py"
                },
                "region": {
                  "startLine": 7
                }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "md5-7"
          }
        },
        {
          "ruleId": "python.flask.security.audit.debug-enabled",
          "level": "warning",
          "message": {
            "text": "Flask debug mode enabled"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/main.py"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "debug-3"
          }
        },
        {
          "ruleId": "generic.secrets.gitleaks.generic-api-key",
          "level": "error",
          "message": {
            "text": "Hard-coded API key"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/config.py"
                },
                "region": {
                  "startLine": 12
                }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "key-12"
          }
        }
      ]
    }
  ]
}